{
  "functions": [
    {
      "source": "functions",
      "codebase": "perfectedu",
      "ignore": [
        "node_modules",
        "*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.production.rules"
  },
  "emulators": {
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
