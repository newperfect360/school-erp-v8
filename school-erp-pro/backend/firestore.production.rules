rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy GBS records remain available only to its authorized administrators.
    // Does not grant access to any document under schools, including memberships.
    match /{legacyCollection}/{legacyDocument}/{nested=**} {
      allow read, write: if legacyCollection in ['students','teachers','attendance','notices','settings','templates','documents','fees'] && admin('gbs-school');
    }

    function member(school) { return get(/databases/$(database)/documents/schools/$(school)/members/$(request.auth.uid)).data; }
    function active(school) { return request.auth != null && get(/databases/$(database)/documents/schools/$(school)).data.status == 'ACTIVE' && member(school).active == true && member(school).passwordSetupComplete == true; }
    function admin(school) { return active(school) && member(school).role in ["Admin","ADMIN","SCHOOL_ADMIN","Super Admin","SUPER_ADMIN","SCHOOL_SUPER_ADMIN"]; }
    function known(resource) { return resource in ['students','parents','teachers','attendance','academic_years','homework','exams','results','fees','library','sports','scholarships','trips','certificates','notifications','communication_logs','settings']; }
    function moduleAllowed(school, resource) {
      let m = member(school);
      return active(school) && m.active == true && m.passwordSetupComplete == true && resource in m.resources && (
        m.role in ["Read Only","READ_ONLY","VIEW_ONLY"] ||
        m.role in ["Admin","ADMIN","SCHOOL_ADMIN","Super Admin","SUPER_ADMIN","SCHOOL_SUPER_ADMIN"] || resource in ['academic_years','notifications','settings'] ||
        (m.role in ["Teacher","TEACHER","Class Teacher","CLASS_TEACHER","Subject Teacher","SUBJECT_TEACHER"] && resource in ['students','parents','attendance','homework','exams','results','communication_logs','certificates']) ||
        (m.role == 'Trip In-charge' && resource in ['students','trips','communication_logs']) ||
        (m.role in ["Sports Teacher","SPORTS_TEACHER"] && resource in ['students','sports','communication_logs']) ||
        (m.role in ["Library Staff","LIBRARIAN"] && resource in ['students','library','communication_logs']) ||
        (m.role in ["Accounts Staff","ACCOUNTANT"] && resource in ['students','fees','communication_logs']) ||
        (m.role in ["Headmaster","HEADMASTER","Clerk","CLERK","Office Staff","STAFF"] && known(resource))
      );
    }
    function scopeAllowed(school, resource, row) {
      let m = member(school);
      return m.role in ["Admin","ADMIN","SCHOOL_ADMIN","Super Admin","SUPER_ADMIN","SCHOOL_SUPER_ADMIN"] || row.class_id in m.classIds ||
        (resource == 'students' && row.id in m.studentIds) ||
        ('studentId' in row.data && row.data.studentId in m.studentIds) ||
        (row.class_id == '' && (resource in ['academic_years','notifications','settings'] || (resource == 'teachers' && m.role in ["Headmaster","HEADMASTER"]))) ||
        (row.class_id == '' && resource == 'library' && m.role in ["Library Staff","LIBRARIAN"]);
    }
    function canWrite(school, collection, row) {
      return !(member(school).role in ["Read Only","READ_ONLY","VIEW_ONLY"]) && moduleAllowed(school, collection) && scopeAllowed(school, collection, row) &&
        (member(school).role in ["Admin","ADMIN","SCHOOL_ADMIN","Super Admin","SUPER_ADMIN","SCHOOL_SUPER_ADMIN"] ||
         (collection == 'teachers' && row.data.get('kind','teacher') == 'staff_attendance' && member(school).role in ["Headmaster","HEADMASTER"]) ||
         !(collection in ['settings','academic_years','notifications','certificates','teachers']));
    }
    function envelope(id) {
      return request.resource.data.keys().hasOnly(['id','class_id','version','updated_at','updated_by','deleted','data']) &&
        request.resource.data.id == id && request.resource.data.class_id is string && request.resource.data.data is map &&
        request.resource.data.version is int && request.resource.data.deleted is bool &&
        request.resource.data.updated_by == request.auth.uid && request.resource.data.updated_at == request.time;
    }
    function linkedScope(school,row) {
      return (row.data.get('kind','') != 'staff_attendance' || getAfter(/databases/$(database)/documents/schools/$(school)/teachers/$(row.data.employeeId)).data.data.get('kind','teacher') in ['teacher','staff']) &&
        (!('studentId' in row.data) || row.data.studentId == '' ||
        getAfter(/databases/$(database)/documents/schools/$(school)/students/$(row.data.studentId)).data.class_id == row.class_id) &&
        (!('className' in row.data) || !('division' in row.data) || row.class_id == row.data.className + ':' + row.data.division);
    }
    function domainValid(collection,row) {
      return (collection != 'teachers' || row.data.get('kind','teacher') != 'staff_attendance' ||
        (!row.deleted && row.data.employeeId is string && row.data.employeeId.size() > 0 && row.id == 'staff_' + row.data.date + '_' + row.data.employeeId && row.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
         row.data.status in ['Present','Absent','Late','On Leave','Half Day','Official Duty','Early Leave'])) &&
        (collection != 'attendance' || (row.data.studentId is string && row.data.studentId.size() > 0 &&
        row.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && row.data.academicYear is string &&
        row.data.academicYear.size() > 0 && row.data.status in ['Present','Absent','Late','Leave','Permission Leave','Approved Leave','Sick Leave','Early Leave','Official Duty','Half Day','Medical Leave','Sports Duty','Trip Duty']));
    }
    function auditMatches(school, collection, id) {
      let key = collection + '_' + id + '_' + string(request.resource.data.version);
      let audit = getAfter(/databases/$(database)/documents/schools/$(school)/audit_logs/$(key)).data;
      return audit.record_id == id && audit.collection == collection && audit.version == request.resource.data.version && audit.actor == request.auth.uid && audit.at == request.time;
    }
    function studentValid(school, id) {
      let row = request.resource.data;
      return row.data.id == id && row.data.name is string && row.data.name.size() > 0 &&
        row.data.grNo.matches('^[A-Za-z0-9._-]{1,100}$') &&
        row.class_id == row.data.className + ':' + row.data.division &&
        getAfter(/databases/$(database)/documents/schools/$(school)/student_gr/$(row.data.grNo.lower())).data.student_id == id;
    }
    match /schools/{school} { allow get: if active(school); allow list, write: if false; }
    match /schools/{school}/members/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin(school));
      allow list: if admin(school);
      // Membership changes use the audited, tenant-verified backend only.
      allow create, update, delete: if false;
    }
    match /schools/{school}/student_gr/{gr} {
      allow get: if active(school);
      allow create: if active(school) && request.resource.data.keys().hasOnly(['student_id']) &&
        getAfter(/databases/$(database)/documents/schools/$(school)/students/$(request.resource.data.student_id)).data.data.grNo.lower() == gr;
      allow update, delete, list: if false;
    }
    match /schools/{school}/audit_logs/{event} {
      allow get: if admin(school) || (active(school) && resource.data.actor == request.auth.uid &&
        moduleAllowed(school,resource.data.collection) &&
        scopeAllowed(school,resource.data.collection,get(/databases/$(database)/documents/schools/$(school)/$(resource.data.collection)/$(resource.data.record_id)).data));
      allow list: if admin(school);
      allow create: if active(school) && request.resource.data.keys().hasOnly(['collection','record_id','version','actor','at','mutation_id','after']) &&
        known(request.resource.data.collection) && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time &&
        event == request.resource.data.collection + '_' + request.resource.data.record_id + '_' + string(request.resource.data.version) &&
        getAfter(/databases/$(database)/documents/schools/$(school)/$(request.resource.data.collection)/$(request.resource.data.record_id)).data.version == request.resource.data.version &&
        getAfter(/databases/$(database)/documents/schools/$(school)/$(request.resource.data.collection)/$(request.resource.data.record_id)).data.updated_by == request.auth.uid &&
        getAfter(/databases/$(database)/documents/schools/$(school)/$(request.resource.data.collection)/$(request.resource.data.record_id)).data.data == request.resource.data.after;
      allow update, delete: if false;
    }
    match /schools/{school}/{collection}/{id} {
      allow get: if known(collection) && moduleAllowed(school,collection) && !exists(/databases/$(database)/documents/schools/$(school)/$(collection)/$(id));
      allow read: if known(collection) && moduleAllowed(school,collection) && scopeAllowed(school,collection,resource.data);
      allow create: if known(collection) && canWrite(school,collection,request.resource.data) && envelope(id) && linkedScope(school,request.resource.data) && domainValid(collection,request.resource.data) && request.resource.data.version == 1 &&
        auditMatches(school,collection,id) && (collection != 'students' || studentValid(school,id));
      allow update: if known(collection) && canWrite(school,collection,resource.data) && scopeAllowed(school,collection,request.resource.data) && envelope(id) && linkedScope(school,request.resource.data) && domainValid(collection,request.resource.data) &&
        (collection != 'teachers' || resource.data.data.get('kind','teacher') != 'staff_attendance' ||
         (request.resource.data.data.kind == 'staff_attendance' && request.resource.data.data.employeeId == resource.data.data.employeeId && request.resource.data.data.date == resource.data.data.date && request.resource.data.data.correctionReason is string && request.resource.data.data.correctionReason.size() > 0 && !request.resource.data.deleted)) &&
        request.resource.data.version == resource.data.version + 1 && auditMatches(school,collection,id) &&
        (admin(school) || request.resource.data.class_id == resource.data.class_id) &&
        (collection != 'students' || (studentValid(school,id) && request.resource.data.data.grNo == resource.data.data.grNo));
      allow delete: if false;
    }
  }
}
