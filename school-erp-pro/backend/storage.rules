rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(school) { return firestore.get(/databases/(default)/documents/schools/$(school)/members/$(request.auth.uid)).data; }
    function allowed(school, student) {
      let m=member(school);
      return request.auth != null && m.active == true &&
        (m.role in ['Admin','Super Admin'] || student in m.studentIds ||
        firestore.get(/databases/(default)/documents/schools/$(school)/students/$(student)).data.class_id in m.classIds);
    }
    match /schools/{school}/students/{student}/{file} {
      allow read: if allowed(school,student);
      allow create: if allowed(school,student) && request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf|audio/(mpeg|wav|ogg|webm|mp4)');
      allow update, delete: if false;
    }
  }
}
