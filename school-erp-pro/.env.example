# Public API location only. This does not enable authentication or migrate data.
VITE_SCHOOL_API_URL=

# Optional public URLs. Blank values use the currently opened Vercel/local origin.
# These four keys are explicitly exposed by vite.config.js; never put secrets here.
WEB_BASE_URL=
PUBLIC_SITE_URL=
API_BASE_URL=
APP_DOWNLOAD_URL=
# Firebase web client identifiers belong here only after the staging project is approved.
# Never put service-account JSON, SMS/WhatsApp tokens or provider secrets in VITE_*.
