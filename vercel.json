{
  "version": 2,
  "framework": null,
  "installCommand": "npm --prefix school-erp-pro ci",
  "buildCommand": "npm run build",
  "outputDirectory": "school-erp-pro/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
